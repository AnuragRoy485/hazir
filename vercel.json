{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/rsvp", "destination": "/api/rsvp" }
  ],
  "functions": {
    "api/rsvp.js": { "includeFiles": "rsvp.html" }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ]}
  ]
}
